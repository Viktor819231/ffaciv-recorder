<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer tool only (not shipped): finds and proves field offsets in a game core DLL that has NO PDB
       (stock BNW), from the binary itself: Lua method registrations -> wrapper -> getter -> [ecx+offset],
       RTTI -> vtables, static-init stores -> globals. Run on Lekmod (which has a PDB) to prove the method. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Iced" Version="1.21.0" />
  </ItemGroup>
</Project>
