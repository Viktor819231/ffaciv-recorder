<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer tool only (not shipped): reads a game core DLL + its PDB and prints the
       member offsets the Outside Recorder needs, so each offset table can be re-made from the PDB. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpPdb.Windows" Version="1.0.4" />
  </ItemGroup>
</Project>
